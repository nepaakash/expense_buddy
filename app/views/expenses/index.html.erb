<p style="color: green"><%= notice %></p>
<div class="card p-4">

  <div class="header-section d-flex justify-space-between mb-4">
    <h1>Listing Expenses</h1>
    <%= button_to "New expense", new_expense_path, class: "btn btn-dark" %>
  </div>
  <div id="expenses">
    <table class="table table-striped table-bordered">
      <thead class="thead-dark">
        <tr>
          <th>#</th>
          <th>User</th>
          <th>Paid By</th>
          <th>Amount</th>
          <th>Paid At</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% @expenses.each_with_index do |expense, index| %>
        <tr>
          <td><%= index+1 %></td>
          <td>
            <%= expense.user_id%>
          </td>
          <td>
            <%= expense.paid_by%>
          </td>
          <td>
            <%= expense.amount%>
          </td>
          <td>
            <%= expense.paid_at&.strftime("%B %d, %Y")%>
          </td>
          <td>
                <p>
            <%= button_to "View Detail", expense,  class: "btn btn-primary" %>
          </p>
          </td>
        </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

